# Required only by a running server, never exposed with NEXT_PUBLIC_.
# Supply a private, stable random secret of at least 32 UTF-8 bytes.
DRAW_HMAC_SECRET=
# Reserved for the third-batch IP aggregation adapter; never log raw IP.
IP_HASH_SALT=

# Server-only OpenAI key. Never prefix with NEXT_PUBLIC_. Empty disables generation.
OPENAI_API_KEY=
