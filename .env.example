# Required only by a running server, never exposed with NEXT_PUBLIC_.
# Supply a private, stable random secret of at least 32 UTF-8 bytes.
DRAW_HMAC_SECRET=
# Reserved for the third-batch IP aggregation adapter; never log raw IP.
IP_HASH_SALT=

# Server-only Alibaba Cloud Model Studio key and matching regional workspace endpoint.
# Never prefix either with NEXT_PUBLIC_. Both are required for generation.
DASHSCOPE_API_KEY=
QWEN_IMAGE_ENDPOINT=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/images/generations
